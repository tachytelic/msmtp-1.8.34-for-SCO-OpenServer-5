diff -ruN orig/msmtp-1.8.34/src/getopt.h msmtp-1.8.34/src/getopt.h
--- orig/msmtp-1.8.34/src/getopt.h	1970-01-01 00:00:00.000000000 +0000
+++ msmtp-1.8.34/src/getopt.h	2026-11-25 18:08:45.522730194 +0000
@@ -0,0 +1,21 @@
+/* getopt_long() for SCO OpenServer 5, whose C library has only getopt().
+ * The function itself comes from GCC libiberty (-liberty). */
+#ifndef SCO_GETOPT_H
+#define SCO_GETOPT_H
+#include <stdarg.h>
+#include <stdio.h>
+struct option {
+    const char *name;
+    int has_arg;
+    int *flag;
+    int val;
+};
+#define no_argument 0
+#define required_argument 1
+#define optional_argument 2
+extern char *optarg;
+extern int optind, opterr, optopt;
+int getopt_long(int argc, char *const *argv, const char *shortopts,
+        const struct option *longopts, int *longind);
+int vasprintf(char **result, const char *format, va_list args);
+#endif
diff -ruN orig/msmtp-1.8.34/src/msgid.c msmtp-1.8.34/src/msgid.c
--- orig/msmtp-1.8.34/src/msgid.c	2023-09-27 18:40:26.000000000 +0000
+++ msmtp-1.8.34/src/msgid.c	2026-11-25 18:08:09.279262264 +0000
@@ -25,6 +25,30 @@
 #include <stdlib.h>
 
 #include "msgid.h"
+
+/* SCO OpenServer 5 has no clock_gettime(). The values only feed a hash that
+ * makes the Message-ID unique, so wall time and the tick count will do. */
+#ifndef CLOCK_REALTIME
+#include <sys/time.h>
+#include <sys/times.h>
+#define CLOCK_REALTIME 0
+#define CLOCK_BOOTTIME 1
+static int clock_gettime(int id, struct timespec *ts)
+{
+    if (id == CLOCK_REALTIME) {
+        struct timeval tv;
+        gettimeofday(&tv, NULL);
+        ts->tv_sec = tv.tv_sec;
+        ts->tv_nsec = tv.tv_usec * 1000;
+    } else {
+        struct tms t;
+        clock_t c = times(&t);
+        ts->tv_sec = c / 100;
+        ts->tv_nsec = (c % 100) * 10000000;
+    }
+    return 0;
+}
+#endif
